# General Application Settings

APP_ENV=development # Application environment (e.g., development, production, test)
APP_NAME="Sprint Tracker" # A user-friendly name for the application

# Backend (Flask) Settings

FLASK_APP=backend/app/app.py # The entry point for the Flask application
FLASK_ENV=development # Flask environment (e.g., development, production, testing)
SECRET_KEY=your_flask_secret_key_here # A strong, random secret key for Flask sessions and security
DEBUG=True # Enable or disable Flask debug mode (True/False)
FLASK_RUN_HOST=0.0.0.0 # Host on which to run the Flask development server (e.g., 0.0.0.0 for Docker)
FLASK_RUN_PORT=5000 # Port on which to run the Flask development server
LOG_LEVEL=INFO # Logging level for the backend (e.g., DEBUG, INFO, WARNING, ERROR, CRITICAL)

# Database (PostgreSQL) Settings

DATABASE_URL=postgresql://your_db_user:your_db_password@db:5432/your_db_name # Full connection string for the PostgreSQL database
POSTGRES_USER=your_db_user # Username for the PostgreSQL database
POSTGRES_PASSWORD=your_db_password # Password for the PostgreSQL database
POSTGRES_DB=your_db_name # Name of the PostgreSQL database
POSTGRES_HOST=db # Hostname for the PostgreSQL database service (e.g., 'db' for Docker Compose, 'localhost' or an IP)
POSTGRES_PORT=5432 # Port for the PostgreSQL database service

# Frontend (React/Vite) Settings

VITE_API_BASE_URL=http://localhost:5000/api # Base URL for the backend API that the frontend will connect to
VITE_APP_TITLE="Sprint Tracker" # Title to display in the frontend application

# Docker Compose Settings (for local development and deployment)

DOCKER_COMPOSE_PROJECT_NAME=sprint_tracker # Project name for Docker Compose, used for container naming
WEB_APP_EXTERNAL_PORT=80 # The port on the host machine that the web application will be exposed on (e.g., 80 for HTTP)
